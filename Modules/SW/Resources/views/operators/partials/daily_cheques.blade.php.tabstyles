@push('css')
<style>
#sw_daily_cheques_table { width: 100%% !important; }
</style>
@endpush

@push('javascript')
<script>
$(function () {

    var swChTable = $('#sw_daily_cheques_table').DataTable({
        processing: true,
        serverSide: false,
        ajax: {
            url: '{{ route('sw.daily-cheques.data') }}',
            dataSrc: 'data',
            data: function (d) { d.location_id = $('#sw_ch_location_id').val(); }
        },
        order: [[1, 'desc']],
        columns: [
            { data: 'action', orderable: false, searchable: false },
            { data: 'collection_form_no' },
            { data: 'shift_no' },
            { data: 'operator' },
            { data: 'customer' },
            { data: 'cheque_no' },
            { data: 'bank' },
            { data: 'cheque_date' },
            { data: 'amount', className: 'text-right' },
            { data: 'total_collection', className: 'text-right' },
            { data: 'note' }
        ],
        // Sums AMOUNT, not total collection: a running total counts the same
        // money once per cheque.
        footerCallback: function () {
            var total = this.api().column(8, { search: 'applied' }).data()
                .reduce(function (a, b) {
                    var n = parseFloat(String(b).replace(/,/g, ''));
                    return a + (isNaN(n) ? 0 : n);
                }, 0);
            $('#sw_ch_footer_total').text(total.toFixed(2));
        }
    });

    $('#sw_ch_location_id').on('change', function () { swChTable.ajax.reload(); });

    $('#sw_ch_operator').on('change', function () {
        var name = $('#sw_ch_operator option:selected').text();
        swChTable.column(3).search($(this).val() ? name : '').draw();
    });

    $('#sw_ch_cheque_no').on('input', function () {
        swChTable.column(5).search($(this).val()).draw();
    });

    $('#sw_ch_bank').on('input', function () {
        swChTable.column(6).search($(this).val()).draw();
    });

});
</script>
@endpush
