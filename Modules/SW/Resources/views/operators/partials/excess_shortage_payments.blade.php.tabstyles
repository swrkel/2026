@include('sw::operators.partials._dropdown_fix')

@push('css')
<style>
#sw_excess_shortage_table { width: 100% !important; }
</style>
@endpush

@push('javascript')
<script>
$(function () {

    /*
     | Client-side, as with the operators table. Location and date range still
     | go to the server - they decide which rows are worth fetching - while
     | operator and type filter what is already here, instantly.
    */
    var swEsTable = $('#sw_excess_shortage_table').DataTable({
        processing: true,
        serverSide: false,
        ajax: {
            url: '{{ route('sw.operators.excess-shortage.data') }}',
            dataSrc: 'data',
            data: function (d) {
                d.location_id = $('#sw_es_location_id').val();
                d.date_range  = $('#sw_es_date_range').val();
            }
        },
        columns: [
            { data: 'date', name: 'pump_operator_payments.transaction_date' },
            { data: 'operator', name: 'pump_operators.name' },
            { data: 'type', name: 'pump_operator_payments.payment_type' },
            { data: 'settlement_no', name: 'pump_operator_payments.settlement_no' },
            { data: 'shift_no', name: 'pump_operator_payments.shift_number' },
            { data: 'amount', name: 'pump_operator_payments.net_amount', className: 'text-right' },
            { data: 'note', name: 'pump_operator_payments.note', orderable: false }
        ],
        // Totals over every FILTERED row across all pages, not the page shown.
        footerCallback: function () {
            var total = this.api()
                .column(5, { search: 'applied' })
                .data()
                .reduce(function (a, b) {
                    var n = parseFloat(String(b).replace(/,/g, ''));
                    return a + (isNaN(n) ? 0 : n);
                }, 0);

            $('#sw_es_footer_total').text(total.toFixed(2));
        }
    });

    // Location and date range refetch; operator and type filter in place.
    $('#sw_es_location_id').on('change', function () {
        swEsTable.ajax.reload();
    });

    $('#sw_es_operator').on('change', function () {
        var name = $('#sw_es_operator option:selected').text();
        swEsTable.column(1).search($(this).val() ? name : '').draw();
    });

    $('#sw_es_type').on('change', function () {
        swEsTable.column(2).search($(this).val() || '').draw();
    });

    // The date range picker is initialised by core on inputs with this id
    // pattern; reload whenever it applies a range.
    $('#sw_es_date_range').on('apply.daterangepicker cancel.daterangepicker change', function () {
        swEsTable.ajax.reload();
    });

});
</script>
@endpush
