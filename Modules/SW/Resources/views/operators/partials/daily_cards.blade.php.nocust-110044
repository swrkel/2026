@push('javascript')
<script>
$(function () {

    var swCdTable = $('#sw_daily_cards_table').DataTable({
        processing: true,
        serverSide: false,
        ajax: {
            url: '{{ route('sw.daily-cards.data') }}',
            dataSrc: 'data',
            data: function (d) { d.location_id = $('#sw_cd_location_id').val(); }
        },
        order: [[1, 'desc']],
        columns: [
            { data: 'action', orderable: false, searchable: false },
            { data: 'date' },
            { data: 'collection_form_no' },
            { data: 'shift_no' },
            { data: 'operator' },
            { data: 'customer' },
            { data: 'card_type' },
            { data: 'card_number' },
            { data: 'slip_no' },
            { data: 'amount', className: 'text-right' },
            { data: 'total_collection', className: 'text-right' },
            { data: 'note' }
        ],
        /*
         | Sums AMOUNT, not total collection.
         |
         | total_collection is a running total - summing it would count the same
         | money once per card, so an operator with three card payments would
         | appear to have taken far more than they did.
        */
        footerCallback: function () {
            var total = this.api().column(9, { search: 'applied' }).data()
                .reduce(function (a, b) {
                    var n = parseFloat(String(b).replace(/,/g, ''));
                    return a + (isNaN(n) ? 0 : n);
                }, 0);
            $('#sw_cd_footer_total').text(total.toFixed(2));
        }
    });

    $('#sw_cd_location_id').on('change', function () { swCdTable.ajax.reload(); });

    $('#sw_cd_operator').on('change', function () {
        var name = $('#sw_cd_operator option:selected').text();
        swCdTable.column(4).search($(this).val() ? name : '').draw();
    });

    $('#sw_cd_card_type').on('change', function () {
        var name = $('#sw_cd_card_type option:selected').text();
        swCdTable.column(6).search($(this).val() ? name : '').draw();
    });

    $('#sw_cd_shift_no').on('input', function () {
        swCdTable.column(3).search($(this).val()).draw();
    });

});
</script>
@endpush
