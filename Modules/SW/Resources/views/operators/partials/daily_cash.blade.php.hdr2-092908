@push('css')
<style>
#sw_daily_cash_table { width: 100%% !important; }
</style>
@endpush

@push('javascript')
<script>
$(function () {

    /*
     | Client-side, as with the operators table. A location's daily cash rows
     | number in the tens; a round trip per filter change costs a second on this
     | estate and buys nothing.
     |
     | Location goes to the server - it decides which rows are worth fetching.
    */
    var swDcTable = $('#sw_daily_cash_table').DataTable({
        processing: true,
        serverSide: false,
        ajax: {
            url: '{{ route('sw.daily-cash.data') }}',
            dataSrc: 'data',
            data: function (d) {
                d.location_id = $('#sw_dc_location_id').val();
            }
        },
        order: [[1, 'desc']],
        columns: [
            { data: 'action', orderable: false, searchable: false },
            { data: 'date' },
            { data: 'collection_form_no', width: '5%', className: 'sw-narrow' },
            { data: 'shift_no', width: '5%', className: 'sw-narrow' },
            { data: 'location_name' },
            { data: 'operator' },
            { data: 'current_amount', className: 'text-right', width: '9%' },
            { data: 'balance_collection', className: 'text-right', width: '9%' },
            { data: 'note' },
            { data: 'created_by', width: '10%', className: 'sw-wrap-name' }
        ],
        /*
         | The total sums CURRENT AMOUNT, not balance collection.
         |
         | balance_collection is a running total - summing it would count the
         | same money once per payment, so an operator with three collections
         | would appear to have handed over far more than they did.
        */
        footerCallback: function () {
            var total = this.api()
                .column(6, { search: 'applied' })
                .data()
                .reduce(function (a, b) {
                    var n = parseFloat(String(b).replace(/,/g, ''));
                    return a + (isNaN(n) ? 0 : n);
                }, 0);

            $('#sw_dc_footer_total').text(total.toFixed(2));
        }
    });

    $('#sw_dc_location_id').on('change', function () {
        swDcTable.ajax.reload();
    });

    $('#sw_dc_operator').on('change', function () {
        var name = $('#sw_dc_operator option:selected').text();
        swDcTable.column(5).search($(this).val() ? name : '').draw();
    });

    $('#sw_dc_shift_no').on('input', function () {
        swDcTable.column(3).search($(this).val()).draw();
    });

    $('#sw_dc_form_no').on('input', function () {
        swDcTable.column(2).search($(this).val()).draw();
    });

});
</script>
@endpush
