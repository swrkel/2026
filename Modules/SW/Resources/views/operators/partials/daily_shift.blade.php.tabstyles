@include('sw::operators.partials._dropdown_fix')

@push('css')
<style>
#sw_daily_shift_table { width: 100%% !important; }
</style>
@endpush

@push('javascript')
<script>
$(function () {

    var swDsTable = $('#sw_daily_shift_table').DataTable({
        processing: true,
        serverSide: false,
        ajax: {
            url: '{{ route('sw.shifts.data') }}',
            dataSrc: 'data',
            data: function (d) {
                d.location_id = $('#sw_ds_location_id').val();
                d.status      = $('#sw_ds_status').val();
            }
        },
        order: [[2, 'desc']],
        columns: [
            { data: 'action', orderable: false, searchable: false },
            { data: 'shift_no' },
            { data: 'date' },
            { data: 'location' },
            { data: 'operators' },
            { data: 'status' },
            { data: 'opened_by' },
            { data: 'closed_at' }
        ]
    });

    $('#sw_ds_location_id, #sw_ds_status').on('change', function () {
        swDsTable.ajax.reload();
    });

    $('#sw_ds_shift_no').on('input', function () {
        swDsTable.column(1).search($(this).val()).draw();
    });

    // Reload after any shift action, so the list reflects what just happened.
    $(document).on('sw:shift-changed', function () { swDsTable.ajax.reload(null, false); });

});
</script>
@endpush
