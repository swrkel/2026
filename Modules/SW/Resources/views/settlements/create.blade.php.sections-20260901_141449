@push('javascript')
<script>
$(function () {

    function swStLoadShifts() {
        var $box = $('#sw_st_shifts');
        var locationId = $('#sw_st_location').val();

        $('#sw_st_body').html('');
        $('#sw_st_save_row').hide();

        if (!locationId) {
            $box.html('<span class="text-muted">{{ __('sw::lang.choose_a_location_first') }}</span>');
            return;
        }

        $box.html('<i class="fa fa-spinner fa-spin"></i>');

        $.get('{{ route('sw.settlements.available-shifts') }}', { location_id: locationId },
            function (rows) {
                if (!rows.length) {
                    $box.html('<span class="text-muted">{{ __('sw::lang.no_closed_shifts') }}</span>');
                    return;
                }

                var html = '';
                $.each(rows, function (i, r) {
                    html += '<label class="sw-shift-check">'
                        + '<input type="checkbox" name="shift_ids[]" value="' + r.id + '">'
                        + '<span>' + $('<div>').text(r.label).html() + '</span>'
                        + '</label>';
                });

                $box.html(html);
            }
        );
    }

    /*
     | The body reloads whenever the chosen shifts change.
     |
     | Settling two shifts is not settling one twice - the figures are summed
     | across them, so the whole body is rebuilt rather than added to.
    */
    function swStLoadBody() {
        var ids = $('#sw_st_shifts input:checked').map(function () { return this.value; }).get();
        var $body = $('#sw_st_body');

        if (!ids.length) {
            $body.html('<div class="text-center text-muted" style="padding:40px">'
                + '{{ __('sw::lang.choose_shifts_to_continue') }}</div>');
            $('#sw_st_save_row').hide();
            return;
        }

        $body.html('<div class="text-center text-muted" style="padding:40px">'
            + '<i class="fa fa-spinner fa-spin"></i></div>');

        $.get('{{ route('sw.settlements.assemble') }}', { shift_ids: ids }, function (html) {
            $body.html(html);
            $('#sw_st_save_row').show();
        }).fail(function () {
            $body.html('<div class="alert alert-danger">{{ __('sw::lang.could_not_assemble') }}</div>');
        });
    }

    $('#sw_st_location').on('change', swStLoadShifts);
    $(document).on('change', '#sw_st_shifts input[type="checkbox"]', function () {
        $(this).closest('.sw-shift-check').toggleClass('is-checked', this.checked);
        swStLoadBody();
    });

    swStLoadShifts();

});
</script>
